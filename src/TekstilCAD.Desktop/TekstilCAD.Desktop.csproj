<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TekstilCAD.Studio</AssemblyName>
    <Version>0.4.0</Version>
    <FileVersion>0.4.0.0</FileVersion>
    <Product>Mono Di Tree CAD</Product>
    <Description>Windows tekstil CAD geliştirme önizlemesi</Description>
    <ApplicationIcon>Assets\Studio.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="FittedResearch\pre-seam.json" LogicalName="FittedCheck.pre-seam.json" />
    <EmbeddedResource Include="FittedResearch\golden.json" LogicalName="FittedCheck.golden.json" />
    <EmbeddedResource Include="FittedResearch\expected-seams.json" LogicalName="FittedCheck.expected-seams.json" />
    <Content Include="FittedResearch\GarmentCode-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Only explicitly requested preview builds use a separate runtime data directory. -->
  <PropertyGroup Condition="'$(TekstilCADIsolatedPreview)' == 'true'">
    <DefineConstants>$(DefineConstants);TEKSTILCAD_ISOLATED_PREVIEW</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TekstilCADAtelierPreview)' == 'true'">
    <DefineConstants>$(DefineConstants);TEKSTILCAD_ATELIER_PREVIEW</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <Compile Include="../../tools/PhotoRegionSharpPrototype/RegionProposal.cs" Link="ExperimentalRegion/RegionProposal.cs" />
    <Compile Include="../../tools/PhotoRegionSharpPrototype/MaskComponents.cs" Link="ExperimentalRegion/MaskComponents.cs" />
    <Compile Include="../../tools/PhotoRegionSharpPrototype/MaskContours.cs" Link="ExperimentalRegion/MaskContours.cs" />
    <Compile Include="../../tools/PhotoRegionSharpPrototype/ContourCollinearReduction.cs" Link="ExperimentalRegion/ContourCollinearReduction.cs" />
    <ProjectReference Include="../TekstilCAD.Core/TekstilCAD.Core.csproj" />
    <ProjectReference Include="../TekstilCAD.FileFormats/TekstilCAD.FileFormats.csproj" />
    <ProjectReference Include="../TekstilCAD.Grading/TekstilCAD.Grading.csproj" />
    <ProjectReference Include="../TekstilCAD.Nesting/TekstilCAD.Nesting.csproj" />
    <ProjectReference Include="../TekstilCAD.Patterns/TekstilCAD.Patterns.csproj" />
    <ProjectReference Include="../TekstilCAD.MachineGateway/TekstilCAD.MachineGateway.csproj" />
  </ItemGroup>
</Project>



